{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "functions": {
    "app.js": {
      "includeFiles": "node_modules/swagger-ui-dist/**"
    }
  }
}